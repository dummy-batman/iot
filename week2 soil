const int SOILPIN = A1;
const int t_value = 500;

void setup() {
  pinMode(SOILPIN, INPUT);
  Serial.begin(9600);
  delay(1000);
  Serial.println("SOIL MOISTURE SENSOR");
}

void loop() {
  int soil = analogRead(SOILPIN);

  if (soil == t_value) {
    Serial.println("Soil moisture calculating");
  }
  else if (soil > t_value) {
    Serial.print("SOIL MOISTURE: ");
    Serial.println(soil);
  }
  else {
    Serial.println("DRY SOIL");
  }

  delay(1000);
}
